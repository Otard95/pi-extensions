{
	"name": "pi-extensions",
	"version": "0.17.0",
	"private": true,
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./extensions"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.11",
		"@earendil-works/pi-agent-core": "0.80.8",
		"@earendil-works/pi-ai": "0.80.8",
		"@earendil-works/pi-coding-agent": "0.80.8",
		"@earendil-works/pi-tui": "0.80.8",
		"@sinclair/typebox": "0.34.41",
		"@types/turndown": "5.0.5",
		"typescript": "5.9.2",
		"vitest": "4.1.4"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"check:full": "node --experimental-strip-types scripts/diagnostics.ts",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@mixmark-io/domino": "2.2.0",
		"minimatch": "^10.2.5",
		"playwright-core": "^1.52.0",
		"turndown": "7.2.0"
	}
}
